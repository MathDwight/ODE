<?xml version="1.0" encoding="utf-8"?>

<section xml:id="schedule" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Schedule</title>

  <p>
   All times are local to Baltimore. Deadlines are specified by the due date and the 11:59PM cut-off for submission.
  </p>

   <p>
   Click a specific week to jump to the page within the correspond Mod. Find printable worksheets and full week activities/alerts within Mods.
  </p>

<table>
