  <preface xml:id="preface-visualization">
    <title>Dynamic Vector Field</title>
    <p> Differential equations help us model the world; geometry and algebra help us understand their solutions.</p>
    <figure xml:id="fig-vector-field">
        <caption>Vector Field Simulation: <m>v_x = 0.1 y^2</m>, <m>v_y = -0.2 y x</m></caption>
        <interactive xml:id="interactive-custom-field" platform="iframe">
            <visual source="fieldplay-vector.html"/>
        </interactive>
    </figure>
</preface>

